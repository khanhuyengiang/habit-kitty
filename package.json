{
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "play": "node src/play.ts",
    "build:web": "node web/build.js",
    "app:sync": "node web/build.js && cap sync android",
    "app:apk": "npm run app:sync && cd android && JAVA_HOME=${JAVA_HOME:-$HOME/android-studio-rabbit1-linux/android-studio/jbr} ./gradlew clean assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../dist/HabitKitty.apk",
    "preview": "node web/preview.js",
    "editor": "node web/editor.js",
    "icons": "node scripts/notify-icons.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource/jersey-15": "^5.3.0",
    "esbuild": "^0.27.7",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "fflate": "^0.8.3"
  },
  "version": "0.4.0"
